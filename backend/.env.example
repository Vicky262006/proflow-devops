# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/proflow_enterprise

# JWT
JWT_SECRET=your_super_secure_jwt_secret_change_this
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_change_this
JWT_EXPIRES_IN=1d

# Frontend URL (for CORS and emails)
FRONTEND_URL=http://localhost:5173

# File Storage (local | cloudinary)
STORAGE_PROVIDER=local

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ProFlow" <noreply@proflow.dev>

# Logging
LOG_LEVEL=info
